# =====================================================================
# 등기 포털 도큐먼트루트 규칙 (가비아 Apache)
#  - 디렉터리 목록 금지
#  - index.php 외 모든 PHP 계열 파일 실행 금지 (업로드 웹쉘이 들어와도 실행되지 않게)
#  - 숨김파일(.htaccess, .git, .env …)·.sql·.md·백업/로그/설정 파일 접근 금지
#  - 실제 파일이 아닌 경로는 전부 index.php 로
# Apache 2.4(Require) 와 2.2(Order/Deny) 를 모두 지원한다.
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

# --- 1) PHP 계열은 기본 전부 차단 ---------------------------------------
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- 2) 프런트 컨트롤러만 허용 (뒤에 오는 섹션이 앞의 것을 덮는다) -------
<Files "index.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# --- 3) 숨김파일 · 문서/덤프/백업/설정 파일 차단 -------------------------
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "(?i)\.(sql|md|bak|old|orig|swp|log|ini|env|sh|dist|lock|json|yml|yaml|xlsx|csv|enc|zip|gz)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- 4) 프런트 컨트롤러 라우팅 -----------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 숨김 경로(/.git/ 등)는 파일이 없어도 404
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# --- 5) 정적 파일에도 nosniff (PHP 응답 헤더는 app/security.php 가 붙인다) --
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always unset X-Powered-By
</IfModule>
